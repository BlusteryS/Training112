  "intents": {
    "birth_date": {
      "pattern": "\\b(?:дат[ауеы] рожден\\w*|когда вы родил\\w*|какого числа вы родил\\w*)\\b",
      "examples": [
        "Назовите дату рождения.",
        "Когда вы родились?",
        "Какого числа вы родились?"
      ],
      "variants": [
        "Я родился {birth_date}.",
        "Дата рождения — {birth_date}."
      ],
      "compact_variants": [
        "{birth_date}."
      ]
    },
    "residence": {
      "pattern": "\\b(?:место жительств\\w*|где вы живете|где проживаете|ваш адрес проживания)\\b",
