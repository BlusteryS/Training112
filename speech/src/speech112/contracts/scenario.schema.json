{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://training112.local/contracts/scenario.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "title",
    "origin",
    "facts",
    "initial_state",
    "states",
    "intents",
    "responses",
    "greeting",
    "clarification",
    "check_in",
    "contact",
    "rubric"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "title": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200
    },
    "classifier_code": {
      "type": "string",
      "pattern": "^[0-9]{6,10}$"
    },
    "origin": {
      "type": "string",
      "enum": [
        "Служба 112",
        "Служба 101 (КИС УСС (МЧС))",
        "Служба 102 (СОДЧ (МВД))",
        "Служба 103",
        "Служба 104",
        "ЦОДД",
        "Мосводоканал",
        "ЭРА-ГЛОНАСС",
        "112 Московской области",
        "112 Калужской области"
      ]
    },
    "facts": {
      "type": "object",
      "minProperties": 1,
      "maxProperties": 100,
      "propertyNames": {
        "$ref": "#/$defs/id"
      },
      "additionalProperties": {
        "type": "string",
        "minLength": 1,
        "maxLength": 1000
      }
    },
    "initial_state": {
      "$ref": "#/$defs/id"
    },
    "states": {
      "type": "array",
      "minItems": 1,
      "maxItems": 32,
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/id"
      }
    },
    "intents": {
      "type": "array",
      "minItems": 1,
      "maxItems": 100,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "examples"
        ],
        "properties": {
          "id": {
            "$ref": "#/$defs/id"
          },
          "examples": {
            "type": "array",
            "minItems": 1,
            "maxItems": 50,
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 500
            }
          }
        }
      }
    },
    "responses": {
      "type": "array",
      "minItems": 1,
      "maxItems": 500,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "intent",
          "states",
          "variants"
        ],
        "properties": {
          "id": {
            "$ref": "#/$defs/id"
          },
          "intent": {
            "$ref": "#/$defs/id"
          },
          "states": {
            "type": "array",
            "minItems": 1,
            "maxItems": 32,
            "uniqueItems": true,
            "items": {
              "$ref": "#/$defs/id"
            }
          },
          "variants": {
            "$ref": "#/$defs/variants"
          },
          "compact_variants": {
            "$ref": "#/$defs/variants"
          },
          "next_state": {
            "$ref": "#/$defs/id"
          },
          "end_call": {
            "type": "boolean"
          }
        }
      }
    },
    "greeting": {
      "$ref": "#/$defs/variants"
    },
    "clarification": {
      "$ref": "#/$defs/variants"
    },
    "check_in": {
      "$ref": "#/$defs/variants"
    },
    "pass_score": {
      "type": "integer",
      "minimum": 0,
      "maximum": 100
    },
    "max_errors": {
      "type": "integer",
      "minimum": 0,
      "maximum": 100
    },
    "rubric": {
      "type": "array",
      "maxItems": 100,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "kind",
          "weight",
          "description"
        ],
        "properties": {
          "id": {
            "$ref": "#/$defs/id"
          },
          "kind": {
            "enum": [
              "field_equals",
              "action",
              "deadline",
              "semantic"
            ]
          },
          "field": {
            "$ref": "#/$defs/id"
          },
          "expected": {
            "type": "string",
            "maxLength": 2000
          },
          "action": {
            "$ref": "#/$defs/id"
          },
          "seconds": {
            "type": "integer",
            "minimum": 1,
            "maximum": 86400
          },
          "weight": {
            "type": "integer",
            "minimum": 1,
            "maximum": 100
          },
          "mandatory": {
            "type": "boolean"
          },
          "description": {
            "type": "string",
            "minLength": 1,
            "maxLength": 1000
          },
          "source": {
            "type": "string",
            "maxLength": 1000
          }
        },
        "allOf": [
          {
            "if": {
              "properties": {
                "kind": {
                  "const": "field_equals"
                }
              }
            },
            "then": {
              "required": [
                "field",
                "expected"
              ]
            }
          },
          {
            "if": {
              "properties": {
                "kind": {
                  "enum": [
                    "action",
                    "deadline"
                  ]
                }
              }
            },
            "then": {
              "required": [
                "action"
              ]
            }
          },
          {
            "if": {
              "properties": {
                "kind": {
                  "const": "deadline"
                }
              }
            },
            "then": {
              "required": [
                "seconds"
              ]
            }
          },
          {
            "if": {
              "properties": {
                "kind": {
                  "const": "semantic"
                }
              }
            },
            "then": {
              "required": [
                "field",
                "expected"
              ]
            }
          }
        ]
      }
    },
    "acceptance_cases": {
      "type": "array",
      "minItems": 3,
      "maxItems": 500,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "text",
          "state"
        ],
        "properties": {
          "text": {
            "type": "string",
            "minLength": 1,
            "maxLength": 500
          },
          "state": {
            "$ref": "#/$defs/id"
          },
          "response_id": {
            "$ref": "#/$defs/id"
          },
          "response_ids": {
            "type": "array",
            "minItems": 1,
            "maxItems": 6,
            "items": {
              "$ref": "#/$defs/id"
            }
          }
        },
        "oneOf": [
          {
            "required": [
              "response_id"
            ]
          },
          {
            "required": [
              "response_ids"
            ]
          }
        ]
      }
    },
    "contact": {
      "$ref": "#/$defs/variants"
    },
    "difficulty": {
      "enum": [
        "basic",
        "intermediate",
        "advanced"
      ]
    },
    "instructions": {
      "type": "string",
      "maxLength": 2000
    }
  },
  "$defs": {
    "id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_]{0,63}$"
    },
    "variants": {
      "type": "array",
      "minItems": 1,
      "maxItems": 16,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 1000
      }
    }
  }
}
