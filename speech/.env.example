# Independent per-node capacity. Set this on each Speech server.
SPEECH_MAX_SESSIONS=1
SPEECH_LISTEN_ADDRESS=127.0.0.1
SPEECH_PORT=5555
SPEECH_MODELS_DIR=./.models
# Existing OpenAI-compatible dialogue endpoint with reasoning disabled.
SPEECH_LLM_URL=http://host.docker.internal:8081/v1
# For remote nodes: server key pair and comma-separated allowed backend public keys.
SPEECH_NODE_PUBLIC_KEY=
SPEECH_NODE_SECRET_KEY=
SPEECH_CLIENT_PUBLIC_KEYS=
